# ============ Shared ============
NODE_ENV=development

# ============ API (apps/api) ============
API_PORT=4000
# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgresql://bizdir:bizdir@localhost:5432/bizdir?schema=public
# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# OTP
OTP_TTL=300
OTP_MAX_ATTEMPTS=5

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# Admin bootstrap (seed)
ADMIN_EMAIL=admin@bizdir.local
ADMIN_PASSWORD=ChangeMe!123

# SMS provider (msg91 | console)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# GSTIN provider (surepass | mock)
GSTIN_PROVIDER=mock
GSTIN_API_BASE=
GSTIN_API_KEY=

# Object storage (R2 / S3-compatible)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bizdir-uploads
R2_PUBLIC_BASE=https://cdn.example.com

# Payments (mock | razorpay)
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ISR revalidation (web <- api)
REVALIDATE_WEBHOOK_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev_revalidate_secret_change_me

# Sentry (optional)
SENTRY_DSN=

# ============ WEB (apps/web) ============
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000/api
NEXT_PUBLIC_WA_COUNTRY_CODE=91
NEXT_PUBLIC_IMAGE_HOST=cdn.example.com
