generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, unaccent, btree_gin]
}

enum UserRole {
  customer
  business_owner
  admin
}

enum UserStatus {
  active
  blocked
}

enum OtpPurpose {
  login
  business_verify
}

enum BusinessStatus {
  draft
  pending_review
  active
  suspended
  rejected
}

enum GstinStatus {
  none
  pending
  verified
  failed
  manual
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum ContactEventType {
  call
  whatsapp
  view_phone
  view_profile
  website
}

enum LocationType {
  state
  city
  area
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone           String     @unique @db.VarChar(15)
  email           String?    @unique
  fullName        String?    @map("full_name") @db.VarChar(120)
  role            UserRole   @default(customer)
  status          UserStatus @default(active)
  isPhoneVerified Boolean    @default(false) @map("is_phone_verified")
  consentAt       DateTime?  @map("consent_at") @db.Timestamptz
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz

  adminCredential AdminCredential?
  businesses      Business[]
  refreshTokens   RefreshToken[]
  reviews         Review[]
  savedBusinesses SavedBusiness[]
  contactEvents   ContactEvent[]
  auditLogs       AuditLog[]

  @@index([role])
  @@map("users")
}

model AdminCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

model OtpCode {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String     @db.VarChar(15)
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose @default(login)
  attempts   Int        @default(0) @db.SmallInt
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ipHash       String?   @map("ip_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(120)
  slug      String     @unique @db.VarChar(140)
  iconUrl   String?    @map("icon_url")
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  parent             Category?            @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]           @relation("CategoryTree")
  businesses         Business[]
  businessCategories BusinessCategory[]
  products           Product[]

  @@index([parentId])
  @@map("categories")
}

model Location {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      LocationType
  parentId  String?      @map("parent_id") @db.Uuid
  name      String       @db.VarChar(120)
  slug      String       @db.VarChar(140)
  pincode   String?      @db.VarChar(6)
  latitude  Decimal?     @db.Decimal(9, 6)
  longitude Decimal?     @db.Decimal(9, 6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  parent     Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children   Location[] @relation("LocationTree")
  businesses Business[]

  @@unique([type, slug, parentId])
  @@index([type])
  @@index([parentId])
  @@index([pincode])
  @@map("locations")
}

model Business {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String         @map("owner_id") @db.Uuid
  name              String         @db.VarChar(200)
  slug              String         @unique @db.VarChar(220)
  publicId          String         @unique @map("public_id") @db.VarChar(12)
  description       String?
  primaryCategoryId String         @map("primary_category_id") @db.Uuid
  locationId        String         @map("location_id") @db.Uuid
  address           String?        @db.VarChar(300)
  pincode           String?        @db.VarChar(6)
  latitude          Decimal?       @db.Decimal(9, 6)
  longitude         Decimal?       @db.Decimal(9, 6)
  contactPhone      String         @map("contact_phone") @db.VarChar(15)
  whatsappNumber    String?        @map("whatsapp_number") @db.VarChar(15)
  email             String?
  website           String?
  logoUrl           String?        @map("logo_url")
  coverUrl          String?        @map("cover_url")
  gstin             String?        @db.VarChar(15)
  gstinStatus       GstinStatus    @default(none) @map("gstin_status")
  gstinVerifiedAt   DateTime?      @map("gstin_verified_at") @db.Timestamptz
  legalName         String?        @map("legal_name") @db.VarChar(200)
  status            BusinessStatus @default(draft)
  isFeatured        Boolean        @default(false) @map("is_featured")
  isSponsored       Boolean        @default(false) @map("is_sponsored")
  subscriptionTier  String?        @map("subscription_tier") @db.VarChar(40)
  ratingAvg         Decimal        @default(0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount       Int            @default(0) @map("rating_count")
  viewCount         Int            @default(0) @map("view_count")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz

  owner           User                   @relation(fields: [ownerId], references: [id])
  primaryCategory Category               @relation(fields: [primaryCategoryId], references: [id])
  location        Location               @relation(fields: [locationId], references: [id])
  categories      BusinessCategory[]
  hours           BusinessHour[]
  images          BusinessImage[]
  products        Product[]
  contactEvents   ContactEvent[]
  reviews         Review[]
  savedBy         SavedBusiness[]
  slugHistory     SlugHistory[]
  subscriptions   BusinessSubscription[]

  @@index([primaryCategoryId, locationId])
  @@index([locationId])
  @@index([status])
  @@index([ownerId])
  @@map("businesses")
}

model BusinessCategory {
  businessId String @map("business_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
  @@map("business_categories")
}

model BusinessHour {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  openTime   String?  @map("open_time") @db.VarChar(5)
  closeTime  String?  @map("close_time") @db.VarChar(5)
  isClosed   Boolean  @default(false) @map("is_closed")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

model BusinessImage {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  url        String
  alt        String? @db.VarChar(200)
  sortOrder  Int     @default(0) @map("sort_order")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_images")
}

model Product {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  name        String         @db.VarChar(200)
  slug        String         @db.VarChar(220)
  publicId    String         @unique @map("public_id") @db.VarChar(12)
  description String?
  categoryId  String?        @map("category_id") @db.Uuid
  price       Decimal?       @db.Decimal(12, 2)
  priceUnit   String?        @map("price_unit") @db.VarChar(30)
  currency    String         @default("INR") @db.Char(3)
  isAvailable Boolean        @default(true) @map("is_available")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id])
  images   ProductImage[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  alt       String? @db.VarChar(200)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model SlugHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(20)
  oldSlug    String   @map("old_slug") @db.VarChar(220)
  businessId String?  @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([entityType, oldSlug])
  @@map("slug_history")
}

model ContactEvent {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  type       ContactEventType
  source     String?          @db.VarChar(40)
  productId  String?          @map("product_id") @db.Uuid
  ipHash     String?          @map("ip_hash") @db.VarChar(64)
  userAgent  String?          @map("user_agent") @db.VarChar(255)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([businessId, createdAt])
  @@index([businessId, type, createdAt])
  @@map("contact_events")
}

model Review {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  rating     Int          @db.SmallInt
  body       String?
  status     ReviewStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
  @@index([businessId, status])
  @@map("reviews")
}

model SavedBusiness {
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("saved_businesses")
}

model SubscriptionPlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  price     Decimal  @default(0) @db.Decimal(10, 2)
  interval  String   @default("monthly") @db.VarChar(20)
  features  Json     @default("[]")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")

  subscriptions BusinessSubscription[]

  @@map("subscription_plans")
}

model BusinessSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  planId     String    @map("plan_id") @db.Uuid
  status     String    @default("none") @db.VarChar(20)
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  endsAt     DateTime? @map("ends_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([businessId])
  @@map("business_subscriptions")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ipHash      String?  @map("ip_hash") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SiteSetting {
  key       String   @id @db.VarChar(80)
  value     String?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("site_settings")
}
